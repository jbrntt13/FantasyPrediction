# Copy this file to .env and fill in the values. .env is git-ignored.
# Every variable can also be set directly in the environment (Docker, Render, etc).

# ─── ESPN league ──────────────────────────────────────────────────────────────
# League id from the fantasy.espn.com URL (leagueId=...)
ESPN_LEAGUE_ID=538595081

# ESPN season key = the calendar year the season ENDS in (2026-27 season -> 2027).
# Leave blank to auto-detect from today's date.
ESPN_YEAR=2027

# Private-league cookies. See README.md "Getting your ESPN cookies".
# ESPN_SWID keeps its curly braces. ESPN_S2 is long and may contain %2B / %2F.
ESPN_S2=
ESPN_SWID={}

# Where daily/weekly odds caches are written (default: ./cache)
#CACHE_DIR=./cache

# ─── Demo mode (optional) ─────────────────────────────────────────────────────
# Replays a cached historical week with no ESPN/NBA calls.
#
# Start command:
#   DEMO_DATE=2026-02-06 DEMO_SPEED=3.0 uvicorn api_server:app --reload --port 8000
# Or with docker:
#   docker run -e DEMO_DATE=2026-02-06 -e DEMO_SPEED=3.0 -p 8000:8000 fantasy-prediction

# The date to simulate as "today" (needs cache/<monday>_weekly_odds.json for that week)
#DEMO_DATE=2026-02-06

# Speed multiplier: how fast games progress
#   1.0 = real-time (5 real hours to complete a game day)
#   3.0 = 3x faster (~100 min to complete)
#   10  = fast demo (30 min to complete)
#   60  = 5 real minutes to complete a full game day (good for quick demos)
#DEMO_SPEED=3.0

# Total simulated hours in a game day (default 5 = 7pm to midnight)
#DEMO_GAME_WINDOW=5.0
